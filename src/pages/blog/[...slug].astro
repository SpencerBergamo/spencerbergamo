---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — Spencer Bergamo`} description={post.data.description}>
    <Navbar />
    <main>
        <div class="page-container">
            <article class="blog-post">
                <a href="/blog" class="back-link">&larr; All posts</a>
                <header class="blog-header">
                    <h1 class="blog-title">{post.data.title}</h1>
                    <div class="blog-meta">
                        <time datetime={post.data.date.toISOString()}>
                            {post.data.date.toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            })}
                        </time>
                        {post.data.tags && post.data.tags.length > 0 && (
                            <div class="tag-row">
                                {post.data.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        )}
                    </div>
                </header>
                <div class="blog-content">
                    <Content />
                </div>
            </article>
        </div>
    </main>
</BaseLayout>

<style>
    .blog-post {
        max-width: 70ch;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--hot-rod-red);
        transition: opacity 0.2s ease;
    }

    .back-link:hover {
        opacity: 0.7;
    }

    .blog-header {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--gray-200);
    }

    .blog-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .blog-meta {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        color: var(--gray-500);
        font-size: 0.9rem;
    }

    .blog-content {
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--gray-700);
    }

    .blog-content :global(h2) {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 2.5rem 0 1rem;
        color: var(--gray-900);
    }

    .blog-content :global(h3) {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 2rem 0 0.75rem;
        color: var(--gray-900);
    }

    .blog-content :global(p) {
        margin-bottom: 1.5rem;
    }

    .blog-content :global(a) {
        color: var(--hot-rod-red);
        text-decoration: underline;
        transition: opacity 0.2s ease;
    }

    .blog-content :global(a:hover) {
        opacity: 0.75;
    }

    .blog-content :global(code) {
        background: var(--gray-100);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: var(--gray-800);
    }

    .blog-content :global(pre) {
        background: var(--gray-900);
        color: var(--gray-100);
        padding: 1.5rem;
        border-radius: 10px;
        overflow-x: auto;
        margin: 1.5rem 0;
    }

    .blog-content :global(pre code) {
        background: none;
        padding: 0;
        color: inherit;
    }

    .blog-content :global(ul),
    .blog-content :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
    }

    .blog-content :global(li) {
        margin-bottom: 0.5rem;
    }

    .blog-content :global(blockquote) {
        border-left: 4px solid var(--hot-rod-red);
        padding-left: 1.5rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: var(--gray-500);
    }

    .blog-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin: 2rem 0;
    }

    @media (max-width: 768px) {
        .blog-title {
            font-size: 2rem;
        }

        .blog-content {
            font-size: 1rem;
        }
    }
</style>
