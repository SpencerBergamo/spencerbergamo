---
import { Bot, Code2, Cpu } from "@lucide/astro";
import Navbar from "../components/Navbar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const focusAreas = [
    {
        icon: Cpu,
        title: "Hardware",
        description:
            "Designing and tinkering with circuits, microcontrollers, and embedded systems.",
    },
    {
        icon: Code2,
        title: "Software",
        description:
            "Building full-stack apps and tools with a focus on clean, reliable code.",
    },
    {
        icon: Bot,
        title: "Robotics",
        description:
            "Bringing hardware and software together to make things move and sense.",
    },
];
---

<BaseLayout>
    <Navbar />
    <main>
        <div class="page-container">
            <section class="hero">
                <h1 class="hero-title">Spencer Bergamo</h1>
                <p class="hero-subtitle">
                    I build across <span class="accent">hardware</span>,
                    <span class="accent">software</span>, and
                    <span class="accent">robotics</span>.
                </p>
                <p class="hero-text">
                    I'm a developer and maker who loves bringing ideas to life —
                    from circuit boards and embedded firmware to web apps,
                    mobile apps, and autonomous systems.
                </p>
            </section>

            <!-- <section class="section">
                <div class="section-header">
                    <h2 class="section-title">What I do</h2>
                </div>
                <div class="focus-grid">
                    {
                        focusAreas.map((area) => (
                            <div class="focus-card">
                                <span class="focus-icon">
                                    <area.icon />
                                </span>
                                <h3>{area.title}</h3>
                                <p>{area.description}</p>
                            </div>
                        ))
                    }
                </div>
            </section> -->

            <section class="section">
                <!-- <div class="section-header">
                    <h2 class="section-title">Featured projects</h2>
                </div> -->
                <div class="gallery">
                    <ProjectCard
                        title="Shutterspace"
                        href="https://shutterspace.app"
                        tagline="Collaborative Photo Albums"
                        description="A mobile app that solves the chaos of group photo sharing. Create private albums to host your memories."
                        links={[
                            {
                                label: "App Store",
                                href: "https://apps.apple.com/us/app/shutterspace/id6504692941",
                            },
                            {
                                label: "Google Play",
                                href: "https://play.google.com/store/apps/details?id=org.bbtechnologies.shutterspace",
                            },
                        ]}
                    />

                    <!-- <ProjectCard
                        title="More on the way"
                        tagline="Hardware & robotics"
                        description="I'm currently building out new hardware and robotics projects. This gallery will grow as they come together."
                    /> -->
                </div>
            </section>
        </div>
    </main>
</BaseLayout>
