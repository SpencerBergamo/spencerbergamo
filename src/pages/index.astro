---
import { Bot, Camera, Code2, Cpu, Rocket } from "@lucide/astro";
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const focusAreas = [
    {
        icon: Cpu,
        title: "Hardware",
        description:
            "Designing and tinkering with circuits, microcontrollers, and embedded systems.",
    },
    {
        icon: Code2,
        title: "Software",
        description:
            "Building full-stack apps and tools with a focus on clean, reliable code.",
    },
    {
        icon: Bot,
        title: "Robotics",
        description:
            "Bringing hardware and software together to make things move and sense.",
    },
];
---

<BaseLayout>
    <Navbar />
    <main>
        <div class="page-container">
            <section class="hero">
                <h1 class="hero-title">Spencer Bergamo</h1>
                <p class="hero-subtitle">
                    I build across <span class="accent">hardware</span>,
                    <span class="accent">software</span>, and
                    <span class="accent">robotics</span>.
                </p>
                <p class="hero-text">
                    I'm a developer and maker who loves bringing ideas to life —
                    from circuit boards and embedded firmware to web apps and
                    autonomous systems. Here are a few of the projects I'm most
                    proud of.
                </p>
            </section>

            <!-- <section class="section">
                <div class="section-header">
                    <h2 class="section-title">What I do</h2>
                </div>
                <div class="focus-grid">
                    {
                        focusAreas.map((area) => (
                            <div class="focus-card">
                                <span class="focus-icon">
                                    <area.icon />
                                </span>
                                <h3>{area.title}</h3>
                                <p>{area.description}</p>
                            </div>
                        ))
                    }
                </div>
            </section> -->

            <section class="section">
                <!-- <div class="section-header">
                    <h2 class="section-title">Featured projects</h2>
                </div> -->
                <div class="gallery">
                    <article class="gallery-card">
                        <div class="gallery-thumb">
                            <Camera />
                        </div>
                        <div class="gallery-body">
                            <h3 class="gallery-title">Shutterspace</h3>
                            <p class="gallery-tagline">
                                Collaborative Photo Albums
                            </p>
                            <p class="gallery-desc">
                                A mobile app that solves the chaos of group
                                photo sharing — friends and family collect
                                memories in private, organized spaces.
                            </p>
                            <div class="tag-row">
                                <span class="tag">Expo</span>
                                <span class="tag">Convex</span>
                                <span class="tag">Cloudflare</span>
                                <span class="tag">Firebase</span>
                            </div>
                            <div class="card-links">
                                <a
                                    href="https://shutterspace.app"
                                    class="card-link"
                                    target="_blank"
                                    rel="noopener noreferrer">Visit</a
                                >
                                <a
                                    href="https://apps.apple.com/us/app/shutterspace/id6504692941"
                                    class="card-link"
                                    target="_blank"
                                    rel="noopener noreferrer">App Store</a
                                >
                                <a
                                    href="https://play.google.com/store/apps/details?id=org.bbtechnologies.shutterspace"
                                    class="card-link"
                                    target="_blank"
                                    rel="noopener noreferrer">Google Play</a
                                >
                            </div>
                        </div>
                    </article>

                    <article class="gallery-card placeholder">
                        <div class="gallery-thumb">
                            <Rocket />
                        </div>
                        <div class="gallery-body">
                            <h3 class="gallery-title">More on the way</h3>
                            <p class="gallery-tagline">Hardware & robotics</p>
                            <p class="gallery-desc">
                                I'm currently building out new hardware and
                                robotics projects. This gallery will grow as
                                they come together.
                            </p>
                        </div>
                    </article>
                </div>
            </section>
        </div>
    </main>
</BaseLayout>
