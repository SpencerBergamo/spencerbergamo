---
import { Menu, X } from "@lucide/astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import githubLogo from "../assets/brands/github-logo.png";
import linkedinLogo from "../assets/brands/linkedin-logo.png";
import xLogo from "../assets/brands/x-logo.png";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const sortedPosts = posts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="navbar">
    <button class="mobile-menu-toggle" aria-label="Toggle menu">
        <Menu class="menu-icon" />
        <X class="close-icon" />
    </button>

    <div class="navbar-content">
        <div class="navbar-brand">
            <a href="/" class="brand-link">
                <span class="brand-dot"></span>
                <span class="brand-name">Spencer Bergamo</span>
            </a>
        </div>

        <div class="nav-section">
            <p class="nav-label">Writing</p>
            <nav class="nav-links" aria-label="Blog">
                {
                    sortedPosts.length === 0 ? (
                        <span class="nav-empty">No posts yet</span>
                    ) : (
                        sortedPosts.map((post) => (
                            <a
                                href={`/blog/${post.slug}`}
                                class:list={[
                                    "nav-link",
                                    {
                                        active:
                                            currentPath ===
                                            `/blog/${post.slug}`,
                                    },
                                ]}
                            >
                                {post.data.title}
                            </a>
                        ))
                    )
                }
            </nav>
        </div>

        <div class="contact-info">
            <a
                href="https://github.com/SpencerBergamo"
                aria-label="GitHub/SpencerBergamo"
            >
                <div class="contact-info-item">
                    <Image src={githubLogo} alt="GitHub" />
                </div>
            </a>
            <a
                href="https://www.linkedin.com/in/spencerbergamo/"
                aria-label="LinkedIn/SpencerBergamo"
            >
                <div class="contact-info-item">
                    <Image src={linkedinLogo} alt="LinkedIn" />
                </div>
            </a>
            <a
                href="https://x.com/spencerbergamo"
                aria-label="Twitter/@spencerbergamo"
            >
                <div class="contact-info-item">
                    <Image src={xLogo} alt="Twitter" />
                </div>
            </a>
        </div>
    </div>
</nav>

<script>
    const toggle = document.querySelector(".mobile-menu-toggle");
    const navbar = document.querySelector(".navbar");

    toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        navbar?.classList.toggle("open");
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!navbar?.contains(target)) {
            navbar?.classList.remove("open");
        }
    });
</script>
